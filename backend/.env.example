# ---------------------------------------------------------------------------
# DSSSMS Backend — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MySQL via Prisma)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# General API rate limit
# 1000 requests / 15 min per IP — sized for a school where many users share
# one NAT address.  Lower this (e.g. to 300) for single-user deployments.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000

# Login-specific rate limit (applied on top of the general limit)
# Only FAILED login attempts count (skipSuccessfulRequests=true).
# 50 failed attempts / 15 min per IP is strict enough to block automated
# brute-force while allowing an entire classroom to log in concurrently.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=50

# Seed (development only — never set these in production)
# Must meet password policy: 8+ chars, upper, lower, digit, special character
SEED_DEFAULT_PASSWORD=REPLACE_WITH_DEV_SEED_PASSWORD
# Set to 'true' ONLY in a controlled local dev environment to reset all demo
# account passwords on reseed. Default (omit or false) is safe: existing
# passwords are never changed.
SEED_RESET_PASSWORDS=false

# Logging
LOG_LEVEL=info
