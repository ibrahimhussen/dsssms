# ====================================================================
# DSSSMS Backend — Production Environment Template
# Copy to .env and fill in real values before deploying.
# NEVER commit the actual .env file to version control.
# ====================================================================

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────────
# Use a managed service (AWS RDS, Google Cloud SQL) in production.
DATABASE_URL=mysql://dsssms_user:REPLACE_DB_PASSWORD@prod-db-host:3306/dsssms_prod

# ── JWT Secrets ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Must be at least 48 characters in production.
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_48_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_STRING_48_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ──────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000

# HTTPS enforcement (set to true when behind a TLS-terminating proxy)
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# ── CORS ─────────────────────────────────────────────────────────────
# Set to the exact origin of your frontend (no trailing slash).
CORS_ORIGIN=https://school.example.com

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=warn
