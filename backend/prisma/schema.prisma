generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// Core authentication table shared by every actor in the system (proposal 5.3.3 - Table: Users).
model User {
  userId               Int                     @id @default(autoincrement())
  username             String                  @unique @db.VarChar(50)
  email                String?                 @unique @db.VarChar(150)
  passwordHash         String                  @map("password") @db.VarChar(255)
  roleId               Int
  status               UserStatus              @default(ACTIVE)
  failedLoginAttempts  Int                     @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  isTemporaryPassword  Boolean                 @default(true)
  profilePicture       String?                 @db.VarChar(500)  // URL or base64 data URL
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  administrator        Administrator?
  auditLogs            AuditLog[]
  finalizedClassrooms  ClassroomFinalization[] @relation("ClassroomFinalizer")
  director             Director?
  notifications        Notification[]  @relation("NotificationRecipient")
  sentNotifications    Notification[]  @relation("NotificationSender")
  parent               Parent?
  refreshTokens        RefreshToken[]
  assignedConducts     StudentConduct[]        @relation("ConductAssigner")
  student              Student?
  finalizedSubjects    SubjectFinalization[]   @relation("SubjectFinalizer")
  reviewedSubjects     SubjectFinalization[]   @relation("SubjectReviewer")
  systemSettingUpdates SystemSetting[]
  teacher              Teacher?
  permissions          UserPermission[]
  role                 Role                    @relation(fields: [roleId], references: [roleId])
  viceDirector         ViceDirector?
  preparedBatches      PromotionBatch[]        @relation("BatchPreparer")
  approvedBatches      PromotionBatch[]        @relation("BatchApprover")
  rejectedBatches      PromotionBatch[]        @relation("BatchRejecter")
  reportedDisciplineRecords DisciplineRecord[] @relation("DisciplineReporter")

  @@index([roleId])
  @@map("users")
}

/// Defines the various user roles within the system (proposal - Table: Roles).
model Role {
  roleId   Int      @id @default(autoincrement())
  roleName RoleName @unique
  users    User[]

  @@map("roles")
}

/// Opaque, rotated refresh tokens for session renewal (hashed at rest).
model RefreshToken {
  id         String    @id @default(uuid())
  userId     Int
  tokenHash  String    @db.VarChar(255)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  replacedBy String?
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Central audit trail — required by proposal NFR "Audit and Logging" / "Access Logging".
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  String?  @db.VarChar(64)
  ipAddress String?  @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

/// Explicit temporary or granular permissions assigned to user accounts.
model UserPermission {
  id         Int       @id @default(autoincrement())
  userId     Int
  permission String    @db.VarChar(100)
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

model Administrator {
  adminId   Int    @id @default(autoincrement())
  userId    Int    @unique
  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)
  user      User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("administrators")
}

model Director {
  directorId Int    @id @default(autoincrement())
  userId     Int    @unique
  firstName  String @db.VarChar(100)
  lastName   String @db.VarChar(100)
  user       User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("directors")
}

model ViceDirector {
  viceDirectorId Int    @id @default(autoincrement())
  userId         Int    @unique
  firstName      String @db.VarChar(100)
  lastName       String @db.VarChar(100)
  user           User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("vice_directors")
}

model Teacher {
  teacherId            Int              @id @default(autoincrement())
  userId               Int              @unique
  firstName            String           @db.VarChar(100)
  lastName             String           @db.VarChar(100)
  qualification        String?          @db.VarChar(255)
  specialization       String?          @db.VarChar(255)
  phoneNumber          String?          @db.VarChar(20)
  attendanceRecords    Attendance[]
  classroomsAsHomeroom Classroom[]      @relation("HomeroomTeacher")
  subjectAssignments   TeacherSubject[]
  user                 User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("teachers")
}

/// Defines classrooms/sections (proposal - Table: Classrooms). Relationship: Classroom (1:M) Student.
model Classroom {
  classroomId        Int                     @id @default(autoincrement())
  className          String                  @db.VarChar(50)
  section            String                  @db.VarChar(10)
  academicYear       String                  @db.VarChar(10)
  homeroomTeacherId  Int?
  session            ClassSession            @default(MORNING)
  finalizations      ClassroomFinalization[]
  homeroomTeacher    Teacher?                @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [teacherId])
  students           Student[]
  subjectAssignments TeacherSubject[]
  conductRecords     StudentConduct[]
  promotionBatches   PromotionBatch[]
  promotionTargets   PromotionEntry[]  @relation("PromotionTarget")
  enrollments        StudentEnrollment[]

  @@unique([className, section, academicYear])
  @@index([homeroomTeacherId], map: "classrooms_homeroomTeacherId_fkey")
  @@map("classrooms")
}

/// Subjects offered by the school. Referenced by Grades and TeacherSubject.
model Subject {
  subjectId          Int                  @id @default(autoincrement())
  subjectCode        String               @unique @db.VarChar(20)
  subjectName        String               @db.VarChar(100)
  teacherAssignments TeacherSubject[]
  gradeConfigs       GradeSubjectConfig[]

  @@map("subjects")
}

/// Resolves which Teacher teaches which Subject to which Classroom (M:N support table).
model TeacherSubject {
  id              Int                   @id @default(autoincrement())
  teacherId       Int
  subjectId       Int
  classroomId     Int
  assignments     Assignment[]
  gradeComponents GradeComponent[]
  finalizations   SubjectFinalization[]
  timetableEntries TimetableEntry[]
  classroom       Classroom             @relation(fields: [classroomId], references: [classroomId], onDelete: Cascade)
  subject         Subject               @relation(fields: [subjectId], references: [subjectId], onDelete: Cascade)
  teacher         Teacher               @relation(fields: [teacherId], references: [teacherId], onDelete: Cascade)

  @@unique([teacherId, subjectId, classroomId])
  @@index([classroomId], map: "teacher_subjects_classroomId_fkey")
  @@index([subjectId], map: "teacher_subjects_subjectId_fkey")
  @@map("teacher_subjects")
}

/// Contains all student-specific information (proposal - Table: Students). Relationship: Classroom (1:M) Student.
model Student {
  studentId                 Int                    @id @default(autoincrement())
  userId                    Int                    @unique
  classroomId               Int
  admissionNumber           String                 @unique @db.VarChar(50)
  firstName                 String                 @db.VarChar(100)
  lastName                  String                 @db.VarChar(100)
  gender                    Gender
  dateOfBirth               DateTime               @db.Date
  address                   String?                @db.VarChar(255)
  enrolledAt                DateTime               @default(now())
  admissionType             AdmissionType          @default(NEW_STUDENT)
  completionYear            String?                @db.VarChar(10)
  lastGradeCompleted        String?                @db.VarChar(20)
  previousAcademicSummary   Json?
  previousSchoolLocation    String?                @db.VarChar(150)
  previousSchoolName        String?                @db.VarChar(150)
  previousSchoolType        String?                @db.VarChar(50)
  previousStudentId         String?                @db.VarChar(50)
  studentStatus             StudentStatus          @default(ACTIVE)
  transferCertificateRef    String?                @db.VarChar(100)
  transferReason            String?                @db.VarChar(255)
  transferredOutAt          DateTime?
  transferredOutDestination String?                @db.VarChar(150)
  transferredOutReason      String?                @db.VarChar(255)
  academicReports           AcademicReport[]
  assignmentSubmissions     AssignmentSubmission[]
  gradeEntries              GradeEntry[]
  notifications             Notification[]
  conductRecords            StudentConduct[]
  parentLinks               StudentParentLink[]
  enrollments               StudentEnrollment[]
  promotionEntries          PromotionEntry[]
  attendanceRecords         Attendance[]
  disciplineRecords         DisciplineRecord[]
  classroom                 Classroom              @relation(fields: [classroomId], references: [classroomId])
  user                      User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([classroomId])
  @@map("students")
}

/// Contains information for student guardians/parents (proposal - Table: Parents). 1:1 with User.
model Parent {
  parentId    Int                 @id @default(autoincrement())
  userId      Int                 @unique
  fullName    String              @db.VarChar(255)
  phoneNumber String?             @db.VarChar(20)
  user        User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  links       StudentParentLink[]

  @@map("parents")
}

/// Resolves the M:N relationship between Parents and Students (a parent may have many
/// children in the system; a student may have more than one registered guardian).
model StudentParentLink {
  id           Int                @id @default(autoincrement())
  studentId    Int
  parentId     Int
  relationship ParentRelationship
  parent       Parent             @relation(fields: [parentId], references: [parentId], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId], map: "student_parent_links_parentId_fkey")
  @@map("student_parent_links")
}

model Attendance {
  attendanceId   Int              @id @default(autoincrement())
  studentId      Int
  teacherId      Int
  classroomId    Int
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?          @db.VarChar(255)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isLocked       Boolean          @default(false)
  period         Int              @default(0)
  student        Student          @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  teacher        Teacher          @relation(fields: [teacherId], references: [teacherId])

  @@unique([studentId, attendanceDate, period])
  @@index([classroomId, attendanceDate, period])
  @@index([teacherId], map: "attendance_teacherId_fkey")
  @@map("attendance")
}

/// One assessment component in a subject's grading scheme for a given
/// teaching assignment + semester + academic year (e.g. "Quiz 1" worth 10
/// marks, out of a scheme that must total 100). A teacher builds this list
/// up component by component. FINAL_EXAM is mandatory and must be worth
/// exactly 50 marks; every other category is optional and the teacher
/// chooses its name and weight, as long as the whole scheme never exceeds
/// 100 marks. Multiple components of the same category are allowed (e.g.
/// "Quiz 1", "Quiz 2"), distinguished by name.
model GradeComponent {
  gradeComponentId Int            @id @default(autoincrement())
  teacherSubjectId Int
  semester         Semester
  academicYear     String         @db.VarChar(10)
  category         GradeCategory
  name             String         @db.VarChar(100)
  maxMarks         Decimal        @db.Decimal(5, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  teacherSubject   TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)
  entries          GradeEntry[]

  @@unique([teacherSubjectId, semester, academicYear, name])
  @@index([teacherSubjectId, semester, academicYear])
  @@map("grade_components")
}

/// One student's score for one grade component.
model GradeEntry {
  gradeEntryId     Int            @id @default(autoincrement())
  gradeComponentId Int
  studentId        Int
  score            Decimal        @db.Decimal(5, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  gradeComponent   GradeComponent @relation(fields: [gradeComponentId], references: [gradeComponentId], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([gradeComponentId, studentId])
  @@index([studentId])
  @@map("grade_entries")
}

model AcademicReport {
  reportId      Int      @id @default(autoincrement())
  studentId     Int
  semester      Semester
  academicYear  String   @db.VarChar(10)
  averageMark   Decimal  @db.Decimal(5, 2)
  rank          Int?
  generatedDate DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, semester, academicYear])
  @@map("academic_reports")
}

/// Official conduct rating assigned by authorized academic staff for a student
/// for a specific academic period. This is separate from discipline incidents and
/// represents the professional academic judgment of the student's general behavior.
model StudentConduct {
  id             Int           @id @default(autoincrement())
  studentId      Int
  classroomId    Int
  academicYear   String        @db.VarChar(10)
  semester       Semester
  rating         ConductRating
  assignedBy     Int
  assignedAt     DateTime      @default(now())
  notes          String?       @db.VarChar(500)
  updatedAt      DateTime      @updatedAt

  assignedByUser User      @relation("ConductAssigner", fields: [assignedBy], references: [userId], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  classroom      Classroom @relation(fields: [classroomId], references: [classroomId])

  @@unique([studentId, classroomId, academicYear, semester])
  @@index([classroomId, academicYear, semester])
  @@index([studentId, academicYear, semester])
  @@index([assignedBy], map: "student_conduct_assignedBy_fkey")
  @@map("student_conduct")
}

/// Tracks the finalization status of subject results for a specific teaching assignment
/// and academic period. This enables the two-stage finalization workflow.
model SubjectFinalization {
  id               Int                @id @default(autoincrement())
  teacherSubjectId Int
  semester         Semester
  academicYear     String             @db.VarChar(10)
  status           FinalizationStatus @default(DRAFT)
  reviewedBy       Int?
  reviewedAt       DateTime?
  finalizedBy      Int?
  finalizedAt      DateTime?
  correctionReason String?            @db.VarChar(500)
  lastCorrectionAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  finalizedByUser  User?              @relation("SubjectFinalizer", fields: [finalizedBy], references: [userId])
  reviewedByUser   User?              @relation("SubjectReviewer", fields: [reviewedBy], references: [userId])
  teacherSubject   TeacherSubject     @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)

  @@unique([teacherSubjectId, semester, academicYear])
  @@index([teacherSubjectId, status])
  @@index([semester, academicYear, status])
  @@index([finalizedBy], map: "subject_finalizations_finalizedBy_fkey")
  @@index([reviewedBy], map: "subject_finalizations_reviewedBy_fkey")
  @@map("subject_finalizations")
}

/// Tracks the finalization status of an entire classroom for an academic period.
/// All subjects must be APPROVED before a classroom can be FINALIZED.
model ClassroomFinalization {
  id               Int                @id @default(autoincrement())
  classroomId      Int
  semester         Semester
  academicYear     String             @db.VarChar(10)
  status           FinalizationStatus @default(DRAFT)
  finalizedBy      Int?
  finalizedAt      DateTime?
  correctionReason String?            @db.VarChar(500)
  lastCorrectionAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  classroom        Classroom          @relation(fields: [classroomId], references: [classroomId], onDelete: Cascade)
  finalizedByUser  User?              @relation("ClassroomFinalizer", fields: [finalizedBy], references: [userId])

  @@unique([classroomId, semester, academicYear])
  @@index([classroomId, status])
  @@index([semester, academicYear, status])
  @@index([finalizedBy], map: "classroom_finalizations_finalizedBy_fkey")
  @@map("classroom_finalizations")
}

model Notification {
  notificationId    Int                  @id @default(autoincrement())
  recipientUserId   Int?
  senderUserId      Int?
  studentId         Int?
  category          NotificationCategory @default(ANNOUNCEMENT)
  title             String               @db.VarChar(150)
  message           String               @db.Text
  sentDate          DateTime             @default(now())
  status            NotificationStatus   @default(UNREAD)
  relatedEntity     String?              @db.VarChar(100)  // e.g. "ClassroomFinalization"
  relatedEntityId   String?              @db.VarChar(64)   // e.g. "42"
  deduplicationKey  String?              @unique @db.VarChar(255) // prevents duplicate auto-notifications

  recipientUser User?    @relation("NotificationRecipient", fields: [recipientUserId], references: [userId], onDelete: Cascade)
  senderUser    User?    @relation("NotificationSender",    fields: [senderUserId],    references: [userId], onDelete: SetNull)
  student       Student? @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@index([studentId])
  @@index([recipientUserId])
  @@index([senderUserId])
  @@index([category])
  @@index([deduplicationKey])
  @@map("notifications")
}

/// One weekly period slot for a teaching assignment (Teacher+Subject+Classroom).
/// Powers the Teacher Portal's "Class Timetable" and the Student Portal's
/// "My Timetable" views. Managed by oversight roles (Admin/Director/Vice
/// Director); teachers and students only ever read their own slice of it.
model TimetableEntry {
  timetableEntryId Int             @id @default(autoincrement())
  teacherSubjectId Int
  dayOfWeek        DayOfWeek
  startTime        String          @db.VarChar(5)
  endTime          String          @db.VarChar(5)
  roomNumber       String?         @db.VarChar(50)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  period           Int             @default(1)
  semester         Semester        @default(SEMESTER_1)
  status           TimetableStatus @default(DRAFT)

  teacherSubject TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)

  @@unique([teacherSubjectId, semester, dayOfWeek, period])
  @@index([teacherSubjectId, semester])
  @@index([teacherSubjectId])
  @@map("timetable_entries")
}

/// Homework/assignment set by a teacher for one of their teaching assignments
/// (a specific subject taught to a specific classroom). Submission tracking
/// is a per-student checklist rather than file upload — this system has no
/// file storage layer, so students self-report completion and teachers can
/// correct that status.
model Assignment {
  assignmentId     Int                    @id @default(autoincrement())
  teacherSubjectId Int
  title            String                 @db.VarChar(150)
  description      String?                @db.Text
  dueDate          DateTime               @db.Date
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  submissions      AssignmentSubmission[]
  teacherSubject   TeacherSubject         @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)

  @@index([teacherSubjectId])
  @@map("assignments")
}

model AssignmentSubmission {
  submissionId Int              @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  status       SubmissionStatus @default(NOT_SUBMITTED)
  submittedAt  DateTime?
  notes        String?          @db.VarChar(500)
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

/// One row per student per academic year — the authoritative enrollment history.
/// Student.classroomId is kept as a convenience pointer to the current row's
/// classroom; StudentEnrollment is the record of truth for all past placements.
model StudentEnrollment {
  id             Int                @id @default(autoincrement())
  studentId      Int
  classroomId    Int
  academicYear   String             @db.VarChar(10)
  decision       EnrollmentDecision @default(ACTIVE)
  promotedFromId Int?
  batchId        Int?
  notes          String?            @db.VarChar(500)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  student      Student            @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  classroom    Classroom          @relation(fields: [classroomId], references: [classroomId])
  batch        PromotionBatch?    @relation(fields: [batchId], references: [id])
  promotedFrom StudentEnrollment? @relation("EnrollmentHistory", fields: [promotedFromId], references: [id])
  successors   StudentEnrollment[] @relation("EnrollmentHistory")

  @@unique([studentId, academicYear])
  @@index([classroomId])
  @@index([batchId])
  @@map("student_enrollments")
}

/// Tracks one promotion batch through its lifecycle: DRAFT → SUBMITTED →
/// APPROVED/REJECTED → COMPLETED. A batch covers one source classroom moving
/// to one target academic year (students may be assigned different target
/// classrooms individually).
model PromotionBatch {
  id                 Int         @id @default(autoincrement())
  sourceAcademicYear String      @db.VarChar(10)
  targetAcademicYear String      @db.VarChar(10)
  sourceClassroomId  Int
  status             BatchStatus @default(DRAFT)
  preparedById       Int
  approvedById       Int?
  rejectedById       Int?
  rejectionReason    String?     @db.VarChar(500)
  submittedAt        DateTime?
  approvedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sourceClassroom Classroom          @relation(fields: [sourceClassroomId], references: [classroomId])
  preparedBy      User               @relation("BatchPreparer", fields: [preparedById], references: [userId])
  approvedBy      User?              @relation("BatchApprover", fields: [approvedById], references: [userId])
  rejectedBy      User?              @relation("BatchRejecter", fields: [rejectedById], references: [userId])
  entries         PromotionEntry[]
  enrollments     StudentEnrollment[]

  @@map("promotion_batches")
}

/// One student's record inside a PromotionBatch — captures the decision,
/// eligibility assessment, target classroom, and any override notes.
model PromotionEntry {
  id                Int               @id @default(autoincrement())
  batchId           Int
  studentId         Int
  eligibilityStatus EligibilityStatus @default(PENDING_REVIEW)
  decision          PromotionDecision @default(PROMOTED)
  targetClassroomId Int?
  averageMark       Decimal?          @db.Decimal(5, 2)
  attendancePercent Decimal?          @db.Decimal(5, 2)
  overrideReason    String?           @db.VarChar(500)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  batch           PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId], references: [studentId])
  targetClassroom Classroom?     @relation("PromotionTarget", fields: [targetClassroomId], references: [classroomId])

  @@unique([batchId, studentId])
  @@index([batchId])
  @@map("promotion_entries")
}

/// Defines which subjects are officially required for a grade in a given
/// academic year, independently of teacher assignments. This is the
/// authoritative subject list for the Academic Register — a subject appears
/// in the register if it exists here, regardless of whether a teacher has
/// been assigned yet.
model GradeSubjectConfig {
  id           Int      @id @default(autoincrement())
  className    String   @db.VarChar(50)   // e.g. "Grade 9", "Grade 10"
  academicYear String   @db.VarChar(10)   // e.g. "2026/27"
  subjectId    Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [subjectId], onDelete: Cascade)

  @@unique([className, academicYear, subjectId])
  @@index([className, academicYear])
  @@map("grade_subject_configs")
}

/// Concurrency-safe sequential counter for student ID generation.
/// One row per admission year. The backend increments lastSequence inside
/// the same transaction that creates the student, so two simultaneous
/// registrations for the same year get different sequence numbers via
/// MySQL row-level locking on the UPDATE.
model StudentIdCounter {
  id           Int      @id @default(autoincrement())
  year         Int      @unique
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("student_id_counters")
}

/// Singleton row (id is always 1) holding school-wide configuration editable
/// from the admin System Settings page.
model SystemSetting {
  id                     Int      @id @default(1)
  schoolName             String   @db.VarChar(150)
  schoolAddress          String?  @db.VarChar(255)
  contactEmail           String?  @db.VarChar(150)
  contactPhone           String?  @db.VarChar(30)
  currentAcademicYear    String   @db.VarChar(10)
  updatedAt              DateTime @updatedAt
  updatedByUserId        Int?
  minimumSubjectPassMark Decimal  @default(40.00) @db.Decimal(5, 2)
  promotionPassMark      Decimal  @default(50.00) @db.Decimal(5, 2)
  updatedBy              User?    @relation(fields: [updatedByUserId], references: [userId])

  @@index([updatedByUserId], map: "system_settings_updatedByUserId_fkey")
  @@map("system_settings")
}

enum RoleName {
  ADMIN
  DIRECTOR
  VICE_DIRECTOR
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum Gender {
  M
  F
}

enum ClassSession {
  MORNING
  AFTERNOON
}

