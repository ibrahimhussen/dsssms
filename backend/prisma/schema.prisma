/// Persistent discipline incident records logged by teachers and vice directors.
model DisciplineRecord {
  id              Int                @id @default(autoincrement())
  studentId       Int
  incidentDate    String             @db.VarChar(10)   // ISO date "YYYY-MM-DD"
  title           String             @db.VarChar(200)
  description     String             @db.Text
  severity        DisciplineSeverity @default(MEDIUM)
  status          DisciplineStatus   @default(OPEN)
  actionTaken     String?            @db.Text
  reportedByUserId Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  student        Student @relation(fields: [studentId],       references: [studentId])
  reportedBy     User    @relation("DisciplineReporter", fields: [reportedByUserId], references: [userId])

  @@index([studentId])
  @@index([reportedByUserId])
  @@map("discipline_records")
}
